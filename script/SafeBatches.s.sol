pragma solidity 0.8.20;

import "forge-std/Script.sol";
import {CutoverCalls} from "./lib/CutoverCalls.sol";

interface ISafeNonce {
    function nonce() external view returns (uint256);
}

/**
 * @notice Writes the Main Safe's cutover batches as Safe Transaction Builder files + a signer
 *         checklist with the expected safeTxHash of each, from script/lib/CutoverCalls.sol (the
 *         exact bytes rehearsed by test/SafeRehearsal.fork.t.sol). Read-only: broadcasts nothing.
 *
 *   PSYNFT_V2=<deployed V2> forge script script/SafeBatches.s.sol --rpc-url mainnet
 *
 * Without PSYNFT_V2 only Step 0 and the §0a, §0b and §1 batches are written (they don't depend on V2).
 * The Safe nonce is read from the chain (or SAFE_NONCE). Batches are assumed to execute in order
 * with consecutive nonces; re-run right before signing if any other Safe tx happened meanwhile.
 * Output: safe-batches/*.json (import in Safe -> Apps -> Transaction Builder) + safe-batches/CHECKLIST.md
 */
contract SafeBatches is Script {
    string internal constant DIR = "safe-batches/";

    function run() external {
        address v2 = vm.envOr("PSYNFT_V2", address(0));
        uint256 nonce = vm.envOr("SAFE_NONCE", type(uint256).max);
        if (nonce == type(uint256).max) {
            try ISafeNonce(CutoverCalls.MAIN_SAFE).nonce() returns (uint256 n) {
                nonce = n;
            } catch {
                nonce = 0;
                console2.log("!! could not read the Safe nonce (no RPC?) - hashes below assume nonce 0");
            }
        }

        string memory md = string.concat(
            "# Main Safe cutover batches - signer checklist\n\n",
            "Generated by `script/SafeBatches.s.sol` from `script/lib/CutoverCalls.sol` (the bytes rehearsed by ",
            "`test/SafeRehearsal.fork.t.sol`). Safe: `",
            vm.toString(CutoverCalls.MAIN_SAFE),
            "` (2-of-4, v1.3.0). Chain id: ",
            vm.toString(block.chainid),
            ".\n\n",
            "**Before signing each batch:** import the JSON in Safe -> Apps -> Transaction Builder, check every row ",
            "below against the decoded transaction in the Safe UI, and check the **safeTxHash on your hardware wallet** ",
            "equals the one listed here. Hashes assume the nonce shown; if the Safe has executed anything else ",
            "since, re-run this script.\n\n"
        );

        md = string.concat(
            md,
            "## Step 0 (individual wallets, not the Safe)\n\n",
            "Each wallet starts a two-step handover to the Main Safe `",
            vm.toString(CutoverCalls.MAIN_SAFE),
            "`. Nothing changes until the Safe accepts. Calldata for every row: `",
            vm.toString(CutoverCalls.coreLogicHandoverCalldata()),
            "` (`transferOwnership(MainSafe)`).\n\n| # | From | To | Call |\n|---|---|---|---|\n"
        );
        CutoverCalls.Handover[] memory h = CutoverCalls.eoaHandovers();
        for (uint256 i; i < h.length; i++) {
            md = string.concat(
                md, "| ", vm.toString(i + 1), " | `", vm.toString(h[i].from), "` | `", vm.toString(h[i].to), "` | ", h[i].label, " |\n"
            );
        }
        md = string.concat(md, "\n");

        md = string.concat(md, _batch("0a-accept-v1-nft", "Section 0a: accept V1 PsyNFT", CutoverCalls.v1NftOwnerBatch(), nonce));
        md = string.concat(
            md, _batch("0b-setup", "Section 0b: accept CoreLogic + PsycSale, fallback handler", CutoverCalls.setupBatch(), nonce + 1)
        );
        md = string.concat(md, _batch("1-freeze", "Section 1: close the exit window", CutoverCalls.freezeBatch(), nonce + 2));
        if (v2 != address(0)) {
            md = string.concat(md, _batch("4c-accept-v2", "Section 4c: accept V2 ownership", CutoverCalls.acceptV2Batch(v2), nonce + 3));
            md = string.concat(
                md, _batch("4d-cutover-sweep", "Section 4d: cutover + exit-pool sweep", CutoverCalls.cutoverBatch(v2, 34), nonce + 4)
            );
        } else {
            md = string.concat(md, "## 4c / 4d\n\nNot generated: set `PSYNFT_V2` to the deployed V2 address and re-run.\n");
        }
        vm.writeFile(string.concat(DIR, "CHECKLIST.md"), md);
        console2.log("wrote safe-batches/*.json and safe-batches/CHECKLIST.md (Safe nonce %s)", nonce);
    }

    function _batch(string memory file, string memory title, CutoverCalls.Call[] memory c, uint256 nonce)
        internal
        returns (string memory md)
    {
        (address to, bytes memory data, uint8 op) = CutoverCalls.safeTxFor(c);
        bytes32 h = CutoverCalls.safeTxHash(CutoverCalls.MAIN_SAFE, block.chainid, to, data, op, nonce);

        string memory txs;
        md = string.concat("## ", title, "\n\nFile: `safe-batches/", file, ".json` - expected nonce **", vm.toString(nonce));
        md = string.concat(md, "** - safeTxHash **`", vm.toString(h), "`**\n\n| # | Call | To | Data |\n|---|---|---|---|\n");
        for (uint256 i; i < c.length; i++) {
            txs = string.concat(
                txs,
                i == 0 ? "" : ",",
                '\n    {"to": "',
                vm.toString(c[i].to),
                '", "value": "0", "data": "',
                vm.toString(c[i].data),
                '", "contractMethod": null, "contractInputsValues": null}'
            );
            md = string.concat(
                md,
                "| ",
                vm.toString(i + 1),
                " | ",
                c[i].label,
                " | `",
                vm.toString(c[i].to),
                "` | `",
                vm.toString(c[i].data),
                "` |\n"
            );
        }
        string memory json = string.concat(
            '{\n  "version": "1.0",\n  "chainId": "',
            vm.toString(block.chainid),
            '",\n  "createdAt": 0,\n  "meta": {"name": "PsyNFT V2 ',
            title,
            '", "description": "Generated by script/SafeBatches.s.sol; see safe-batches/CHECKLIST.md", "createdFromSafeAddress": "',
            vm.toString(CutoverCalls.MAIN_SAFE),
            '"},\n  "transactions": [',
            txs,
            "\n  ]\n}\n"
        );
        vm.writeFile(string.concat(DIR, file, ".json"), json);
        md = string.concat(
            md,
            "\nExecuted as: ",
            op == 1 ? "DELEGATECALL to MultiSendCallOnly `" : "CALL to `",
            vm.toString(to),
            "`\n\n"
        );
    }
}
