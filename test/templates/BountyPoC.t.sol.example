import "forge-std/Test.sol";
import {PsyNFTV2} from "src/PsyNFTV2.sol";

contract BountyPoC is Test {
    PsyNFTV2 internal nft;

    // Production-like roles: one Safe holds owner + core + treasury.
    address internal safe = makeAddr("mainSafe");
    address internal alice = makeAddr("alice"); // an honest holder
    address internal attacker = makeAddr("attacker");

    function setUp() public {
        // Optional fork: vm.createSelectFork(vm.envString("MAINNET_RPC_URL"));
        nft = new PsyNFTV2(safe);
        vm.startPrank(safe);
        nft.setCoreContract(safe);
        nft.setTreasury(safe);
        nft.setBaseUri("ipfs://bafyexample/");

        // Migrated state, like mainnet: alice holds seat 1, the schedule resumes at 34/21.
        address[] memory holders = new address[](1);
        uint256[] memory ids = new uint256[](1);
        holders[0] = alice;
        ids[0] = 1;
        nft.migrateBatch(holders, ids);
        nft.finalizeMigration(34, 21, true, 1);
        nft.batchMintInFibonacci(); // ids 34..54 held by the contract
        vm.stopPrank();
    }

    function test_Exploit() public {
        vm.startPrank(attacker);
        // ... your exploit here ...
        vm.stopPrank();

        // Assert the impact, e.g.:
        // assertEq(nft.ownerOf(1), attacker, "attacker took alice's seat");

        revert("TODO: replace with your exploit and assertions"); // the template fails until filled in
    }
}
