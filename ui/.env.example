# ---------------------------------------------------------------------------
# SECURITY: every VITE_* variable is BAKED INTO THE CLIENT BUNDLE at build time
# and is readable by anyone who can load the app. Never put a secret here.
# ---------------------------------------------------------------------------

# Optional: pre-fill the contract address so users don't have to paste it.
# (Public information — safe to set.)
VITE_CONTRACT_ADDRESS=

# Optional: a read-only RPC URL used for the dashboard before a wallet is connected.
# ⚠ If this URL embeds an API key (Alchemy/Infura), that key SHIPS TO EVERY VISITOR
# of a hosted build. Use a keyless public endpoint, or a domain-restricted key.
VITE_RPC_URL=

# Optional: the chain this deployment lives on (1 = mainnet, 11155111 = Sepolia, 31337 = sandbox).
# When set, the app shows a red banner if the connected wallet is on another network.
# VITE_CHAIN_ID=1
